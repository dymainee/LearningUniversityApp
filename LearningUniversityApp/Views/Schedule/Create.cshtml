@model LearningUniversityApp.ViewModels.ScheduleCreateViewModel
<body>
	<form asp-controller="Schedule" asp-action="CreatePost" method="post">

		<div class="container mt-4">
			<div class="row">
				<div class="col-12">
					<h2 class="text-center text-uppercase mb-5"> Створити нову групу </h2>
				</div>
			</div>
		</div>
		<div class="row justify-content-center">
			<div class="col-12 d-flex flex-column align-items-center">
				<div class="col-12 mb-3">
					<select asp-for="GroupId" asp-items="Model.Groups" class="form-control">
						<option value="">-- Оберіть групу --</option>
					</select>
				</div>
				<div class="col-12 mb-3">
					<select asp-for="TeacherId" asp-items="Model.Teachers" class="form-control">
						<option value="">-- Оберіть вчителя --</option>
					</select>
				</div>
				<div class="col-12 mb-3">
					<label>Предмет</label>
					<select asp-for="SubjectId" asp-items="Model.Subjects" class="form-control">
						<option value="">-- Оберіть предмет --</option>
					</select>
				</div>

				<div class="col-12 mb-3">
					<label>День тижня</label>
					<select asp-for="Day" asp-items="Model.Days" class="form-control">
						<option value="">-- Оберіть день --</option>
					</select>
				</div>
				<button type="submit" class="btn btn-success">Відправити</button>
			</div>
		</div>
	</form>

</body>