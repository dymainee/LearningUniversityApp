@model LearningUniversityApp.ViewModels.ScheduleCreateViewModel

<body>
	<form asp-controller="Schedule" asp-action="EditPost" method="post">
		<input asp-for="Id" type="hidden" />

		<div class="container mt-4">
			<div class="row">
				<div class="col-12">
					<h2 class="text-center text-uppercase mb-5"> Modify a group </h2>
				</div>
			</div>
		</div>
		<div class="row justify-content-center">
			<div class="col-12 d-flex flex-column align-items-center">
				<div class="col-12 mb-3">
					<label>Choose a day of the week</label>
					<select asp-for="Day" asp-items="Model.Days" class="form-control">
						<option value="">-- Day of the week --</option>
					</select>
				</div>

				<div class="col-12 mb-3">
					<label>Lesson number</label>
					<select asp-for="LessonNumber" asp-items="Model.LessonNumbers" class="form-control">
						<option value="">-- Choose a lesson number --</option>
					</select>
				</div>

				<div class="col-12 mb-3">
					<label>Groups Id</label>
					<select asp-for="GroupId" asp-items="Model.Groups" class="form-control">
						<option value="">-- Choose a group --</option>
					</select>
				</div>
				<div class="col-12 mb-3">
					<label>Tutors</label>
					<select asp-for="TeacherId" asp-items="Model.Teachers" class="form-control">
						<option value="">-- Choose a tutor --</option>
					</select>
				</div>
				<div class="col-12 mb-3">
					<label>Subjects</label>
					<select asp-for="SubjectId" asp-items="Model.Subjects" class="form-control">
						<option value="">-- Choose subject --</option>
					</select>
				</div>
				<button type="submit" class="btn btn-success">submit</button>
			</div>
		</div>
	</form>
</body>