@model LearningUniversityApp.Models.Group

<body>
	<form asp-controller="Group" asp-action="EditGroupPost" method="post">
		<input type="hidden" asp-for="Id" />

		<div class="container mt-4">
			<div class="row">
				<div class="col-12">
					<h2 class="text-center text-uppercase mb-5"> Modify a group </h2>
				</div>
			</div>
		</div>
		<div class="row justify-content-center">
			<div class="col-12 d-flex flex-column align-items-center">
				<div class="col-12 mb-3">
					<label asp-for="Title" class="form-label">Change a name of the group</label>
					<input asp-for="Title" class="form-control" placeholder="Enter a name of the group" required>
				</div>
				<div class="col-12 mb-3">
					<label asp-for="Description" class="form-label">Description</label>
					<input asp-for="Description" class="form-control" placeholder="Enter a valid description" required>
				</div>
				<button type="submit" class="btn btn-success">Submit</button>
			</div>
		</div>
	</form>

</body>