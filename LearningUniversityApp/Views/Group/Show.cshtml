@using LearningUniversityApp.ViewModels
@model GroupFilterViewModel
<body>
	<section class="Groups">
		<div class="row">
			<div class="col-12">
				<h2 class="text-center text-uppercase mb-5"> All Groups </h2>
			</div>
		</div>
		<div class="row">
			<div class="col-12 d-flex justify-content-center">
				<form asp-controller="Group" asp-action="Show">
					<table class="table table-primary">
						<thead>
							<tr>
								<input name="id_filter" type="number">
								<input name="title_filter" type="text">
								<input name="description_filter" type="text">
								<button type="submit">Застосувати</button>
							</tr>
							<tr>
								<th scope="col">Id</th>
								<th scope="col">Title</th>
								<th scope="col">Description</th>
								<th scope="col">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (Group group in Model.groups)
							{
								<tr>
									<th scope="row">@group.Id</th>
									<td>@group.Title</td>
									<td>@group.Description</td>
									<td>
										<div class="d-flex gap-3">
											<a asp-controller="Group" asp-action="Edit" asp-route-id="@group.Id"
											   class="btn btn-primary btn-sm px-5 ">
												Modify
											</a>
											<form asp-controller="Group" asp-action="Delete" asp-route-id="@group.Id">
												<button type="submit" class="btn btn-danger btn-sm px-5">
													Delete
												</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
					
				</form>
			</div>
		</div>
		<div class="row">
			<div class="col-12 d-flex align-items-center justify-content-center">
				<a asp-controller="Group" asp-action="Add"
				   class="btn btn-primary btn-sm px-5 mt-3" style="background-color:lightblue ">Add a new Group</a>
				<a asp-controller="Group" asp-action="ReturnToMenu"
				   class="btn btn-primary btn-sm px-5 mt-3" style="background-color:lightblue ">Return back</a>
			</div>
		</div>
	</section>

</body>