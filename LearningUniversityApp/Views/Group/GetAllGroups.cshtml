@model List<LearningUniversityApp.Models.Group>

<body>
	<section class="Groups">
		<div class="row">
			<div class="col-12">
				<h2 class="text-center text-uppercase mb-5"> Всі групи </h2>
			</div>
		</div>
		<div class="row">
			<div class="col-12 d-flex justify-content-center">
				<table class="table table-primary ">
					<thead>
						<tr>
							<th scope="col">Id</th>
							<th scope="col">Title</th>
							<th scope="col">Description</th>
							<th scope="col">Actions</th>
						</tr>
					</thead>
					<tbody>
						@foreach (Group group in Model)
						{
							<tr>

								<th scope="row">@group.Id</th>
								<td>@group.Title</td>
								<td>@group.Description</td>
								<td>
									<div class="d-flex gap-3">
										<a asp-controller="Group" asp-action="EditGroup" asp-route-id="@group.Id"
										   class="btn btn-primary btn-sm px-5 ">
											Змінити
										</a>
										<form asp-controller="Group" asp-action="DeleteGroup" asp-route-id="@group.Id">
											<button type="submit" class="btn btn-danger btn-sm px-5">
												Видалити
											</button>
										</form>
									</div>
								</td>
							</tr>
						}
					</tbody>

				</table>
			</div>
		</div>
		<div class="row">
			<div class="col-12 d-flex align-items-center justify-content-center">
				<a asp-controller="Group" asp-action="CreateGroup"
				   class="btn btn-primary btn-sm px-5 mt-3" style="background-color:lightblue ">Створити</a>
				<a asp-controller="Group" asp-action="ReturnToMenu"
				   class="btn btn-primary btn-sm px-5 mt-3" style="background-color:lightblue ">Вернутись</a>
			</div>
		</div>
	</section>

</body>