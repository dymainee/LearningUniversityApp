@model List<LearningUniversityApp.Models.Subject>

<body>
	<section class="Groups">
		<div class="row">
			<div class="col-12">
				<h2 class="text-center text-uppercase mb-5"> All subjects </h2>
			</div>
		</div>
		<div class="row">
			<div class="col-12 d-flex justify-content-center">
				<table class="table table-primary ">
					<thead>
						<tr>
							<th scope="col">Id</th>
							<th scope="col">Title</th>
						</tr>
					</thead>
					<tbody>
						@foreach (Subject subject in Model)
						{
							<tr>

								<th scope="row">@subject.Id</th>
								<td>@subject.Title</td>
								<td>
									<div class="d-flex gap-3">
										<a asp-controller="Subject" asp-action="Edit" asp-route-id="@subject.Id"
										   class="btn btn-primary btn-sm px-5 ">
											Modify
										</a>
										<form asp-controller="Subject" asp-action="Delete" asp-route-id="@subject.Id">
											<button type="submit" class="btn btn-danger btn-sm px-5">
												Delete
											</button>
										</form>
									</div>
								</td>
							</tr>
						}
					</tbody>

				</table>
			</div>
		</div>
		<div class="row">
			<div class="col-12 d-flex align-items-center justify-content-center">
				<a asp-controller="Subject" asp-action="Add"
				   class="btn btn-primary btn-sm px-5 mt-3" style="background-color:lightblue ">Add</a>
				<a asp-controller="Subject" asp-action="ReturnToMenu"
				   class="btn btn-primary btn-sm px-5 mt-3" style="background-color:lightblue ">Return back</a>
			</div>
		</div>
	</section>

</body>