@model LearningUniversityApp.Models.Subject

<body>
	<form asp-controller="Subject" asp-action="EditPost" method="post">
		<input type="hidden" asp-for="Id" />

		<div class="container mt-4">
			<div class="row">
				<div class="col-12">
					<h2 class="text-center text-uppercase mb-5"> Modify a subject </h2>
				</div>
			</div>
		</div>
		<div class="row justify-content-center">
			<div class="col-12 d-flex flex-column align-items-center">
				<div class="col-12 mb-3">
					<label asp-for="Title" class="form-label">Title of subject</label>
					<input asp-for="Title" class="form-control" placeholder="Enter a valid name of subject" required>
				</div>
				<button type="submit" class="btn btn-success">Submit</button>
			</div>
		</div>
	</form>

</body>