@model LearningUniversityApp.ViewModels.TeacherCreateViewModel
<body>
	<form asp-controller="Teacher" asp-action="AddPost" method="post">

		<div class="container mt-4">
			<div class="row">
				<div class="col-12">
					<h2 class="text-center text-uppercase mb-5"> Add tutor </h2>
				</div>
			</div>
		</div>
		<div class="row justify-content-center">
			<div class="col-12 d-flex flex-column align-items-center">
				<div class="col-12 mb-3">
					<label asp-for="Name" class="form-label">Name</label>
					<input asp-for="Name" class="form-control" placeholder="Enter a valid tutor name" required>
				</div>
				<div class="col-12 mb-3">
					<label asp-for="Surname" class="form-label">Surname</label>
					<input asp-for="Surname" class="form-control" placeholder="Enter a valid surname" required>
				</div>
				<div class="col-12 mb-3">
					<label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
					<input type="date" asp-for="DateOfBirth" required>
				</div>

				<div class="col-12 mb-3 ">
					@foreach (Subject subject in Model.subjects)
					{
						<input type="checkbox" name="SelectedSubjectIds" value="@subject.Id"></input>
						<label>@subject.Title</label>
					}
				</div>
				<button type="submit" class="btn btn-success">Submit</button>
			</div>
		</div>
	</form>

</body>
