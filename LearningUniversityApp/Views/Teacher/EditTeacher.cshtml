@model LearningUniversityApp.Models.Teacher
<body>
	<form asp-controller="Teacher" asp-action="EditTeacherPost" method="post">
		<input type="hidden" asp-for="Id" />

		<div class="container mt-4">
			<div class="row">
				<div class="col-12">
					<h2 class="text-center text-uppercase mb-5"> Редагувати нову групу </h2>
				</div>
			</div>
		</div>
		<div class="row justify-content-center">
			<div class="col-12 d-flex flex-column align-items-center">
				<div class="col-12 mb-3">
					<label asp-for="Name" class="form-label">ім'я вчителя</label>
					<input asp-for="Name" class="form-control" placeholder="Вкажіть ім'я вчителя" required>
				</div>
				<div class="col-12 mb-3">
					<label asp-for="Surname" class="form-label">призвіще вчителя</label>
					<input asp-for="Surname" class="form-control" placeholder="Вкажіть призвіще вчителя" required>
				</div>
				<div class="col-12 mb-3">
					<label asp-for="DateOfBirth" class="form-label">Дата народження</label>
					<input type="date" asp-for="DateOfBirth" required>
				</div>
				<button type="submit" class="btn btn-success">Відправити</button>
			</div>
		</div>
	</form>

</body>