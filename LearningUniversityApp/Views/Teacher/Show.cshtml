@model List<LearningUniversityApp.Models.Teacher>

<body>
	<section class="Teachers">
		<div class="row">
			<div class="col-12">
				<h2 class="text-center text-uppercase mb-5"> All tutors </h2>
			</div>
		</div>
		<div class="row">
			<div class="col-12 d-flex justify-content-center">
				<table class="table table-primary ">
					<thead>
						<tr>
							<th scope="col">Id</th>
							<th scope="col">Name</th>
							<th scope="col">Surname</th>
							<th scope="col">DateOfBirth</th>
							<th scope="col">Subjects</th>
						</tr>
					</thead>
					<tbody>
						@foreach (Teacher teacher in Model)
						{
							<tr>
								<th scope="row">@teacher.Id</th>
								@* <td>@teacher.Name</td>
								<td>@teacher.Surname</td>
								<td>@teacher.DateOfBirth</td> *@
								<td>
								@foreach (SubjectTeacher subjectTeacher in teacher.SubjectTeachers)
								{
									@subjectTeacher.Subject.Title
									@if (subjectTeacher != teacher.SubjectTeachers.Last())
									{
										<span>, </span>
									}
								}
								</td>

								<td>
									<div class="d-flex gap-3">
										<a asp-controller="Teacher" asp-action="Schedule" asp-route-id="@teacher.Id"
										   class="btn btn-primary btn-sm px-5 ">
											Schedule
										</a>
										<a asp-controller="Teacher" asp-action="Edit" asp-route-id="@teacher.Id"
										   class="btn btn-primary btn-sm px-5 ">
											Modify
										</a>
										<form asp-controller="Teacher" asp-action="Delete" asp-route-id="@teacher.Id">
											<button type="submit" class="btn btn-danger btn-sm px-5">
												Delete
											</button>
										</form>
									</div>
								</td>
							</tr>
						}
					</tbody>

				</table>
			</div>
		</div>
		<div class="row">
			<div class="col-12 d-flex align-items-center justify-content-center">
				<a asp-controller="Teacher" asp-action="Add"
				   class="btn btn-primary btn-sm px-5 mt-3" style="background-color:lightblue ">Add</a>
				<a asp-controller="Teacher" asp-action="ReturnToMenu"
				   class="btn btn-primary btn-sm px-5 mt-3" style="background-color:lightblue ">Return back</a>
			</div>
		</div>
	</section>

</body>
