@model LearningUniversityApp.ViewModels.StudentCreateViewModel

<form 
    asp-controller="Student" 
    asp-action="AddPost"
    method="post">

    <label>Name</label>
    <input asp-for="Name">

    <label>Surname</label>
    <input asp-for="Surname">

    <label>Date of birth</label>
    <input type="date" asp-for="DateOfBirth">

    <select asp-for="GroupId" asp-items="Model.Groups" class="form-control">
        <option value="">-- Choose a group --</option>
    </select>

    <button type="submit">Submit</button>

</form>