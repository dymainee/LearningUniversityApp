@model LearningUniversityApp.Models.Student

<form asp-controller="Student"
      asp-action="EditPost"
      method="post">

    <input type="hidden" asp-for="Id">

    <label>Name</label>
    <input asp-for="Name">

    <label>Surname</label>
    <input asp-for="Surname">

    <label>Date of birth</label>
    <input type="date" asp-for="DateOfBirth">

    <button type="submit">Submit</button>

</form>