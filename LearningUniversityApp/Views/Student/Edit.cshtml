@model LearningUniversityApp.Models.Student

<form asp-controller="Student"
      asp-action="EditPost"
      method="post">

    <input type="hidden" asp-for="Id">

    <label>Ім'я</label>
    <input asp-for="Name">

    <label>Прізвище</label>
    <input asp-for="Surname">

    <label>Дата народження</label>
    <input type="date" asp-for="DateOfBirth">

    <button type="submit">Зберегти</button>

</form>