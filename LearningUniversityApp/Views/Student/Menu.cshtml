
<body>
    <section class="menu">
        <div class="container mt-4">
            <div class="row">
                <div class="col-12">
                    <h2 class="text-center text-uppercase mb-5">Choose option</h2>
                </div>
            </div>

            <div class="row justify-content-center mb-3">
                <div class="col-md-4 d-flex justify-content-center">
                    <a asp-controller="Group" asp-action="GetAllGroups" class="btn btn-sm w-100" style="background-color:lightblue">Конфігурація групи</a>
                </div>
                <div class="col-md-4 d-flex justify-content-center">
                    <a asp-controller="Student" asp-action="GetAll" class="btn btn-sm w-100" style="background-color:lightblue">Конфігурація студента</a>
                </div>
                <div class="col-md-4 d-flex justify-content-center">
                    <a asp-controller="Teacher" asp-action="Show" class="btn btn-sm w-100" style="background-color:lightblue">Конфігурація вчителя</a>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-md-4 d-flex justify-content-center">
                    <a asp-controller="Schedule" asp-action="Show" class="btn btn-sm w-100" style="background-color:lightblue">Конфігурація графіка</a>
                </div>
                <div class="col-md-4 d-flex justify-content-center">
                    <a asp-controller="Subject" asp-action="Show" class="btn btn-sm w-100" style="background-color:lightblue">Конфігурація предмета</a>
                </div>
            </div>
        </div>
    </section>
</body>

